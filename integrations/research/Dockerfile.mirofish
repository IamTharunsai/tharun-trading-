FROM python:3.12.12-slim-bookworm AS build
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates build-essential && rm -rf /var/lib/apt/lists/*
RUN git init /engine && git -C /engine remote add origin https://github.com/666ghj/MiroFish.git && git -C /engine fetch --depth=1 origin 7657031ac01184afe2cb220f5ee3545573b5e843 && git -C /engine checkout --detach FETCH_HEAD && test "$(git -C /engine rev-parse HEAD)" = 7657031ac01184afe2cb220f5ee3545573b5e843
WORKDIR /engine/backend
RUN uv sync --frozen --no-dev --no-editable
COPY patch_mirofish.py /tmp/patch_mirofish.py
RUN python /tmp/patch_mirofish.py /engine/backend/app/utils/logger.py && find /engine -name '.env*' -type f -delete && rm -rf /engine/.git
# Import as the actual runtime UID, with no provider credentials. Engine files
# remain root-owned; only the explicit temporary log directory is writable.
RUN mkdir /tmp/import-logs && chown 10001:10001 /tmp/import-logs && MIROFISH_LOG_DIR=/tmp/import-logs PYTHONDONTWRITEBYTECODE=1 .venv/bin/python -c "import os; os.setgroups([]); os.setgid(10001); os.setuid(10001); from app import create_app; assert callable(create_app)" && rm -rf /tmp/import-logs /tmp/patch_mirofish.py

FROM python:3.12.12-slim-bookworm
RUN groupadd --gid 10001 research && useradd --uid 10001 --gid research --no-create-home research && mkdir /data && chown research:research /data
COPY --from=build /engine /engine
COPY gateway.py mirofish_worker.py provider_worker.py pins.json boot.py /bridge/
ENV RESEARCH_SERVICE=mirofish PYTHONDONTWRITEBYTECODE=1 PORT=8080 FLASK_DEBUG=False
CMD ["python", "/bridge/boot.py"]
