// APEX TRADER - Prisma Database Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows); linux targets cover CI sandbox + Railway (Debian/OpenSSL 3.0) staging deploys.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// OWNER AUTH
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  lastLogin    DateTime?
  sessionToken String?
  ipWhitelist  Json     @default("[]")
  role         String   @default("OWNER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  predictionExecutions PredictionExecution[]
}

// TRADES
model Trade {
  id               String        @id @default(cuid())
  asset            String
  market           String
  type             TradeType
  entryPrice       Float
  exitPrice        Float?
  quantity         Float
  pnl              Float?
  pnlPct           Float?
  fees             Float         @default(0)
  status           TradeStatus   @default(OPEN)
  brokerOrderId    String?
  brokerConfirmed  Boolean       @default(false)
  agentDecisionId  String?
  agentDecision    AgentDecision? @relation(fields: [agentDecisionId], references: [id])
  predictionExecution PredictionExecution?
  accountId        String?
  brokerMode       String?
  positionId       String?
  position         Position? @relation(fields: [positionId], references: [id])
  closedQuantity   Float @default(0)
  feeQuantity      Float @default(0)
  actualFeeCash    Float @default(0)
  realizedPnl      Float @default(0)
  exitNotional     Float @default(0)
  unrealizedPnl    Float @default(0)
  unrealizedPnlPct Float @default(0)
  openedAt         DateTime      @default(now())
  closedAt         DateTime?
  stopLossPrice    Float?
  takeProfitPrice  Float?
  exitReason       String?
  reconciliationStatus String?   @default("RECONCILED")
  fillLatencyMs    Float?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([asset])
  @@index([status])
  @@index([closedAt])
  @@index([openedAt])
}

enum TradeType {
  BUY
  SELL
}

enum TradeStatus {
  PENDING
  OPEN
  CLOSED
  CANCELLED
  FAILED
  REJECTED
  LOCAL_SIMULATION
}

// AGENT DECISIONS
model AgentDecision {
  id              String   @id @default(cuid())
  asset           String
  signal          String
  finalVote       String
  totalVotes      Int
  goVotes         Int
  noGoVotes       Int
  avgConfidence   Float
  executed        Boolean  @default(false)
  executionReason String?
  agentVotes      Json
  marketSnapshot  Json
  regime          String?
  horizon         String?  @default("INTRADAY")
  inputDataFreshnessMs Float?
  timestamp       DateTime @default(now())
  trades          Trade[]
  executionIntent ExecutionIntent?

  @@index([asset])
  @@index([timestamp])
  @@index([asset, regime])
}

// One durable claim per council decision. Ambiguous submissions retain their claim.
model ExecutionIntent {
  id                String @id @default(cuid())
  decisionId        String @unique
  decision          AgentDecision @relation(fields: [decisionId], references: [id])
  clientOrderId     String @unique
  brokerOrderId     String? @unique
  asset             String
  market            String
  mode              String
  accountId         String
  executionPlan     Json
  direction         String
  quantity          Float
  referencePrice    Float
  protection        String
  status            String @default("SUBMITTING")
  fillPrice         Float?
  fillQuantity      Float?
  lastBrokerState   Json?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([mode, accountId, status])
}

// Persists round1/round2 debate outputs as they complete, so a crash or
// redeploy mid-debate (e.g. Railway landing a deploy mid-run) can resume
// from the last completed round instead of re-running (and re-billing)
// earlier rounds. One row per asset (a second debate on the same asset
// can't start while one is in flight - see debateLocks in scheduler.ts),
// deleted once the debate finishes successfully.
model DebateCheckpoint {
  id             String   @id @default(cuid())
  asset          String   @unique
  status         String   // 'ROUND1_DONE' | 'ROUND2_DONE'
  round1Results  Json
  round2Exchange Json?
  marketRegime   String
  inputFingerprint String?
  evidenceBundle Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// OPEN POSITIONS
model Position {
  id             String   @id @default(cuid())
  asset          String
  // Legacy rows have no verified account identity. Nullable during rollout;
  // broker-reconciled entries always supply their account/mode/symbol scope key.
  scopeKey       String? @unique @default(cuid())
  accountId      String?
  brokerMode     String?
  pendingEntryIntentId String?
  brokerObservedQuantity Float?
  brokerObservedEntryPrice Float?
  brokerObservedAt DateTime?
  accountingStatus String @default("UNVERIFIED")
  accountingError String?
  evidenceVersion Int @default(0)
  trades         Trade[]
  exits          PositionExit[]
  market         String
  side           String   @default("BUY")
  quantity       Float
  entryPrice     Float
  currentPrice   Float
  stopLossPrice  Float
  takeProfitPrice Float
  unrealizedPnl  Float    @default(0)
  unrealizedPnlPct Float  @default(0)
  protectionStatus String @default("APPLICATION_MONITORED")
  brokerPositionId String?
  status         String   @default("OPEN")
  openedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StrategyQualification {
  id                 String @id @default(cuid())
  strategyKey        String
  revision           String
  dataHash           String
  reportHash         String
  trialCount         Int
  noLeakage          Boolean @default(false)
  dsrProbability     Float
  walkForwardPassed  Boolean @default(false)
  costsValidated     Boolean @default(false)
  executionValidated Boolean @default(false)
  ledgerReconciled   Boolean @default(false)
  healthPassed       Boolean @default(false)
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  evidence           Json
  @@index([strategyKey, revision, createdAt])
}

// Durable cadence/lease for research of an existing account-bound position cycle.
model PositionResearch {
  id              String @id @default(cuid())
  cycleKey        String @unique
  positionId      String
  accountId       String
  brokerMode      String
  asset           String
  status          String @default("PENDING")
  leaseToken      String?
  leaseUntil      DateTime?
  nextReviewAt    DateTime @default(now())
  lastAttemptAt   DateTime?
  lastCompletedAt DateTime?
  decisionId      String?
  observation     String?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, brokerMode, nextReviewAt])
}

model PositionExit {
  id                 String @id @default(cuid())
  cycleKey           String @unique
  positionId         String
  position           Position @relation(fields: [positionId], references: [id])
  accountId          String
  brokerMode         String
  symbol             String
  side               String
  quantity           Float
  clientOrderId      String @unique
  brokerOrderId      String?
  reason             String
  attempt            Int @default(1)
  evidenceKind       String @default("CLIENT_ORDER")
  status             String @default("PREPARING")
  appliedQuantity    Float @default(0)
  appliedNotional    Float @default(0)
  realizedPnl        Float @default(0)
  entryBasis         Float @default(0)
  error              String?
  brokerEvidence     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([accountId, brokerMode, status, updatedAt])
}

// Immutable broker identity plus the cumulative amount already applied under the
// account/symbol lock. Holdings are observations, never execution evidence.
model BrokerOrderEvidence {
  id String @id @default(cuid())
  accountId String
  brokerMode String
  brokerOrderId String
  positionId String
  positionCycleAt DateTime
  parentOrderId String?
  symbol String
  side String
  source String
  status String
  allocationComplete Boolean @default(true)
  appliedQuantity Decimal @default(0) @db.Decimal(30, 12)
  appliedNotional Decimal @default(0) @db.Decimal(30, 12)
  brokerUpdatedAt DateTime?
  evidence Json
  observedAt DateTime @default(now())
  @@unique([accountId, brokerMode, brokerOrderId])
  @@index([positionId, positionCycleAt])
}

// Activity IDs deduplicate delayed fee/fill observations. Unknown linkage is
// deliberately retained; finding one local lot does not prove fee ownership.
model BrokerActivity {
  id String @id @default(cuid())
  accountId String
  brokerMode String
  brokerActivityId String
  activityType String
  brokerOrderId String?
  symbol String?
  currency String?
  quantity Decimal? @db.Decimal(30, 12)
  cashAmount Decimal? @db.Decimal(30, 12)
  effectiveAt DateTime?
  dateOnly Boolean @default(false)
  attributionStatus String @default("UNATTRIBUTED")
  evidence Json
  observedAt DateTime @default(now())
  appliedAt DateTime?
  @@unique([accountId, brokerMode, brokerActivityId])
  @@index([accountId, brokerMode, attributionStatus])
}

model BrokerFillAllocation {
  id String @id @default(cuid())
  orderEvidenceId String
  tradeId String
  quantity Decimal @default(0) @db.Decimal(30, 12)
  notional Decimal @default(0) @db.Decimal(30, 12)
  @@unique([orderEvidenceId, tradeId])
}

// PORTFOLIO SNAPSHOTS
// Raw broker observations and prior responses are retained separately from the
// revisable risk projection. Legacy snapshots/basis/P&L are never back-assigned.
model CapitalRiskState {
  scopeKey String @id
  accountId String
  brokerMode String
  referenceAt DateTime
  coveredThrough DateTime?
  activityThrough DateTime?
  fullBackfillAt DateTime?
  backfillCursor DateTime?
  lastAttemptAt DateTime?
  revision Int @default(0)
  status String @default("UNVERIFIED")
  error String?
  @@unique([accountId, brokerMode])
}

model CapitalRiskPoint {
  id String @id @default(cuid())
  accountId String
  brokerMode String
  endAt DateTime
  equity Decimal @db.Decimal(30, 12)
  externalCapital Decimal @db.Decimal(30, 12)
  cashflows Json
  complete Boolean
  revision Int
  observationId String
  @@unique([accountId, brokerMode, endAt])
}

model CapitalRiskActivity {
  id String @id @default(cuid())
  accountId String
  brokerMode String
  brokerActivityId String
  activityType String
  classification String
  amount Decimal? @db.Decimal(30, 12)
  dateOnly Boolean
  effectiveFrom DateTime?
  effectiveTo DateTime?
  evidence Json
  observationId String
  @@unique([accountId, brokerMode, brokerActivityId])
}

// Append-only finite SSE evidence. A row records an observation, never an
// immutable promise of future coverage; late postings require a fresh read.
model CapitalActivityCoverageObservation {
  id String @id @default(cuid())
  accountId String
  brokerMode String
  accountCreatedAt DateTime
  since DateTime
  until DateTime
  observedAt DateTime @default(now())
  digest String
  events Json
  transportComplete Boolean
  @@index([accountId, brokerMode, until], map: "CapitalActivityCoverage_account_mode_until_idx")
}

model CapitalRiskObservation {
  id String @id @default(cuid())
  accountId String
  brokerMode String
  revision Int
  observedAt DateTime
  activityAfter DateTime
  activityUntil DateTime
  history Json
  activities Json
  @@unique([accountId, brokerMode, revision])
}

model PortfolioSnapshot {
  id          String   @id @default(cuid())
  totalValue  Float
  cashBalance Float
  invested    Float
  pnlDay      Float    @default(0)
  pnlDayPct   Float    @default(0)
  pnlTotal    Float    @default(0)
  pnlTotalPct Float    @default(0)
  source      String   @default("VERIFIED_LEDGER")
  accountId   String?
  brokerMode  String?
  timestamp   DateTime @default(now())
  // Legacy numeric defaults are raw observations, never verified risk returns.
  riskDataComplete Boolean @default(false)
  riskAsOf DateTime?
  riskReferenceAt DateTime?
  riskRevision Int?
  riskRecomputedAt DateTime?
  adjustedDailyPnl Decimal? @db.Decimal(30, 12)
  adjustedDailyPnlPct Decimal? @db.Decimal(30, 12)
  adjustedWeeklyPnlPct Decimal? @db.Decimal(30, 12)
  adjustedPeakLossPct Decimal? @db.Decimal(30, 12)

  @@index([timestamp])
  @@index([totalValue])
  @@index([accountId, brokerMode, timestamp])
}

// NEWS FEED
model NewsItem {
  id              String   @id @default(cuid())
  headline        String
  source          String
  url             String?
  sentimentScore  Float
  sentimentLabel  String
  assetsMentioned String[]
  summary         String?
  publishedAt     DateTime
  createdAt       DateTime @default(now())

  @@index([publishedAt])
  @@index([assetsMentioned])
}

// DAILY JOURNAL
model DailyJournal {
  id           String   @id @default(cuid())
  date         String   @unique
  summary      String
  totalTrades  Int      @default(0)
  pnlDay       Float    @default(0)
  pnlDayPct    Float    @default(0)
  bestTrade    Json?
  worstTrade   Json?
  marketNotes  String?
  agentPerformance Json?
  createdAt    DateTime @default(now())
}

// FUTURE PREDICTIONS
model Prediction {
  id              String    @id @default(cuid())
  asset           String
  market          String?   @default("polymarket")
  title           String?
  category        String?
  direction       String?
  confidence      Float
  yesPrice        Float?
  noPrice         Float?
  targetPrice     Float?
  currentPrice    Float?
  timeHorizon     String?
  edge            Float?
  recommendedBet  String?
  expectedValue   Float?
  kellyFraction   Float?
  recommendedWager Float?
  reasoning       String?
  status          String?   @default("ACTIVE")
  keyRisks        String[]
  wasCorrect      Boolean?
  resolvedAt      DateTime?
  resolvedPrice   Float?
  createdAt       DateTime  @default(now())

  @@index([asset])
  @@index([createdAt])
}

// MARKET EVENTS
model MarketEvent {
  id        String   @id @default(cuid())
  asset     String
  eventType String
  data      Json
  timestamp DateTime @default(now())

  @@index([asset])
  @@index([eventType])
  @@index([timestamp])
}

// SYSTEM LOGS
model SystemLog {
  id        String   @id @default(cuid())
  level     String
  service   String
  message   String
  metadata  Json?
  timestamp DateTime @default(now())

  @@index([level])
  @@index([service])
  @@index([timestamp])
}

// AGENT CONVERSATIONS (Agent Chat System)
model AgentConversation {
  id              String   @id @default(cuid())
  agentId         String
  agentName       String
  userMessage     String
  agentResponse   String
  context         Json?
  sessionId       String?
  reactions       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentId])
  @@index([createdAt])
  @@index([sessionId])
}

// AGENT LESSONS (Self-Learning System)
model AgentLesson {
  id              String   @id @default(cuid())
  agentId         String
  agentName       String
  asset           String
  setupType       String
  prediction      String
  outcome         String
  correct         Boolean
  reasoning       String
  confidenceScore Float
  newWeighting    Float
  tradeId         String?
  performanceImpact Float
  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([asset])
  @@index([setupType])
  @@index([createdAt])
}

// AGENT PERFORMANCE SUMMARY
model AgentPerformance {
  id                String   @id @default(cuid())
  agentId           String   @unique
  agentName         String
  totalTrades       Int      @default(0)
  winRate           Float    @default(0)
  accuracy          Float    @default(0)
  profitFactor      Float    @default(1)
  sharpRatio        Float    @default(0)
  maxDrawdown       Float    @default(0)
  avgConfidence     Float    @default(0)
  lessonsLearned    Int      @default(0)
  status            String   @default("ACTIVE")
  suspendedAt       DateTime?
  lastUpdated       DateTime @default(now()) @updatedAt
  weeklyReport      Json?

  @@index([agentId])
  @@index([status])
}

// AGENT ADJUSTMENTS (Owner-made tweaks)
model AgentAdjustment {
  id              String   @id @default(cuid())
  agentId         String
  agentName       String
  adjustmentType  String
  description     String
  beforeValue     String
  afterValue      String
  reason          String
  appliedAt       DateTime @default(now())
  effectiveness   Float?
  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([appliedAt])
}

// LEARNING RESOURCES (External data that agents learn from)
model LearningResource {
  id                String   @id @default(cuid())
  type              String   // 'news', 'fundamental', 'macro', 'on_chain'
  asset             String
  title             String
  content           String
  sentiment         String   // 'bullish', 'bearish', 'neutral'
  sentimentScore    Float    // -1 to 1
  confidence        Float    // 0 to 1
  source            String
  relevanceScore    Float
  metadata          Json?
  timestamp         DateTime @default(now())
  expiresAt         DateTime?
  createdAt         DateTime @default(now())

  @@index([type])
  @@index([asset])
  @@index([sentiment])
  @@index([timestamp])
}

// GEOPOLITICAL EVENTS
model GeopoliticalEvent {
  id                String   @id @default(cuid())
  title             String
  description       String
  eventType         String   // 'sanctions', 'regulation', 'war', 'election', 'trade', 'policy', 'natural_disaster'
  severity          Int      // 1-10 scale
  countries         String[]
  affectedAssets    String[]
  geoRiskScore      Float    // 0-100
  impactDuration    String
  marketImpact      String   // 'negative', 'positive', 'neutral'
  source            String
  timestamp         DateTime @default(now())
  followUpRequired  Boolean  @default(false)
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([eventType])
  @@index([geoRiskScore])
  @@index([timestamp])
}

// MACRO INDICATORS
model MacroIndicator {
  id                String   @id @default(cuid())
  name              String   // 'FED_RATE', 'INFLATION', 'UNEMPLOYMENT', 'VIX', 'USD_EUR', etc
  value             Float
  previousValue     Float?
  unit              String
  importance        String   // 'critical', 'high', 'medium', 'low'
  direction         String   // 'up', 'down', 'stable'
  source            String
  lastUpdated       DateTime
  nextRelease       DateTime?
  expectedValue     Float?
  impact            String   // 'bullish', 'bearish', 'neutral'
  notes             String?
  createdAt         DateTime @default(now())

  @@index([name])
  @@index([importance])
  @@index([lastUpdated])
}

// AGENT LEARNING STATE (Snapshot of learning for specific asset)
model AgentLearningState {
  id                String   @id @default(cuid())
  agentId           String
  assetId           String
  fundamentalScore  Float    // 0-100
  technicalScore    Float    // 0-100
  sentimentScore    Float    // 0-100
  riskScore         Float    // 0-100
  confidenceAdjustment Float
  overallScore      Float    // 0-100, weighted combination
  learningSources   Json     // { news: [...], fundamentals: [...], macro: [...], onChain: [...] }
  recommendations   String   // 'BUY', 'SELL', 'HOLD'
  lastUpdated       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@unique([agentId, assetId])
  @@index([agentId])
  @@index([assetId])
  @@index([overallScore])
}

// COMPANY FUNDAMENTALS (Phase 2 - fetched from Polygon.io weekly)
model CompanyFundamentals {
  id                String   @id @default(cuid())
  symbol            String   @unique
  name              String?
  sector            String?
  industry          String?
  marketCap         Float?
  peRatio           Float?
  pbRatio           Float?
  psRatio           Float?
  revenueGrowthYoy  Float?
  epsGrowthYoy      Float?
  grossMargin       Float?
  operatingMargin   Float?
  netMargin         Float?
  debtToEquity      Float?
  currentRatio      Float?
  dividendYield     Float?
  beta              Float?
  week52High        Float?
  week52Low         Float?
  avgVolume         Float?
  sharesOutstanding Float?
  insiderOwnership  Float?
  institutionalOwnership Float?
  analystRating     String?   // 'STRONG_BUY','BUY','HOLD','SELL','STRONG_SELL'
  analystTargetPrice Float?
  nextEarningsDate  DateTime?
  rawAnalysis       Json?
  lastUpdated       DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([symbol])
  @@index([sector])
  @@index([marketCap])
}

// ANNUAL REPORTS - key metrics from 10-K filings (Phase 3)
model AnnualReport {
  id              String   @id @default(cuid())
  symbol          String
  year            Int
  revenue         Float?
  netIncome       Float?
  eps             Float?
  freeCashFlow    Float?
  totalDebt       Float?
  totalAssets     Float?
  totalEquity     Float?
  revenueGrowth   Float?
  netIncomeGrowth Float?
  epsGrowth       Float?
  dividendPaid    Float?
  sharesBuyback   Float?
  source          String   @default("fmp")
  createdAt       DateTime @default(now())

  @@unique([symbol, year])
  @@index([symbol])
  @@index([year])
}

// STOCK MEMORY - self-learning per stock per agent (Phase 4)
model StockMemory {
  id              String   @id @default(cuid())
  symbol          String
  totalDebates    Int      @default(0)
  totalTrades     Int      @default(0)
  wins            Int      @default(0)
  losses          Int      @default(0)
  winRate         Float    @default(0)
  avgPnlPct       Float    @default(0)
  bestSetup       String?
  worstSetup      String?
  avgHoldHours    Float    @default(0)
  lastDebateVote  String?
  lastTradeOutcome String?
  keyLessons      String[] @default([])
  avoidConditions String[] @default([])
  favorConditions String[] @default([])
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([symbol])
  @@index([symbol])
  @@index([winRate])
}

// GEO RISK ASSESSMENT (Summary of global risk)
model GeoRiskAssessment {
  id                String   @id @default(cuid())
  timestamp         DateTime @default(now())
  overallRisk       Int      // 0-100
  geoRisk           Int      // 0-100
  policyRisk        Int      // 0-100
  marketRisk        Int      // 0-100
  activeEvents      Int      // Number of active events
  tradingMode       String   // 'aggressive', 'balanced', 'conservative', 'hibernation'
  recommendations   String   // Trading advice based on risk
  criticalEvents    Json?    // Array of events triggering high risk
  metadata          Json?    // Additional structured context for the assessment
  createdAt         DateTime @default(now())

  @@index([timestamp])
  @@index([overallRisk])
}


// Added 2026-09-28: models the application uses that were previously only
// in the (never-deployed) SQLite layer. All additive - safe for `db push`.

model Settings {
  id                 String   @id @default("settings-1")
  tradingMode        String   @default("paper")
  maxPositionSizePct Float    @default(15)
  maxRiskPerTradePct Float    @default(2)
  dailyLossLimitPct  Float    @default(3)
  weeklyLossLimitPct Float    @default(6)
  stopLossStocksPct  Float    @default(4)
  stopLossCryptoPct  Float    @default(6)
  takeProfitPct      Float    @default(10)
  minAgentConfidence Float    @default(70)
  minVotesToExecute  Int      @default(8)
  cashReservePct     Float    @default(20)
  killSwitchActive   Boolean  @default(false)
  // Broker credentials entered in Settings, AES-256-GCM encrypted with ENCRYPTION_KEY
  alpacaApiKeyEnc    String?
  alpacaSecretKeyEnc String?
  alpacaPaperMode    Boolean  @default(true)
  polymarketAddress  String?
  updatedAt          DateTime @default(now()) @updatedAt
}

model GuardrailLog {
  id        String   @id @default(cuid())
  rule      String
  triggered Boolean  @default(false)
  details   String?
  createdAt DateTime @default(now())
}

model ProviderSyncRecord {
  id                String   @id @default(cuid())
  provider          String
  feedType          String
  totalSynchronized Int      @default(0)
  totalEligible     Int      @default(0)
  totalSkipped      Int      @default(0)
  totalStale        Int      @default(0)
  totalFailed       Int      @default(0)
  latencyMs         Float    @default(0)
  status            String   @default("SUCCESS")
  lastSyncAt        DateTime @default(now())

  @@index([provider, feedType])
}

model BrokerReconciliation {
  id                  String   @id @default(cuid())
  broker              String
  brokerOrderId       String
  localTradeId        String?
  symbol              String
  orderStatus         String
  submittedQty        Float
  filledQty           Float
  avgPrice            Float?
  discrepancyDetected Boolean  @default(false)
  discrepancyDetails  String?
  timestamp           DateTime @default(now())
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  action    String
  success   Int
  reason    String?
  timestamp DateTime @default(now())

  @@index([email])
  @@index([timestamp])
}

model RevokedToken {
  token     String    @id
  revokedAt DateTime  @default(now())
  expiresAt DateTime?
}

model TradeLifecycleAudit {
  id                   String    @id @default(cuid())
  correlationId        String
  account              String?
  provider             String?
  environment          String?
  strategy             String?
  symbol               String?
  previousState        String?
  newState             String?
  providerTimestamp    DateTime?
  applicationTimestamp DateTime  @default(now())
  sourceDataIds        Json?
  reason               String?
  errors               Json?
  retryCount           Int       @default(0)
  modelVersion         String?
  configVersion        String?
  metadata             Json?

  @@index([correlationId])
  @@index([symbol])
}

model InvestmentThesis {
  id                     String   @id @default(cuid())
  symbol                 String
  version                Int      @default(1)
  thesis                 String
  targetHorizonDays      Int?
  reviewConditions       Json?
  invalidationConditions Json?
  valuationMultiple      Float?
  targetPrice            Float?
  status                 String   @default("ACTIVE")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@index([symbol])
}

model EventIntelligence {
  id                  String    @id @default(cuid())
  provider            String
  originalId          String?
  url                 String?
  publishedAt         DateTime
  receivedAt          DateTime  @default(now())
  symbols             Json?
  headline            String
  normalizedText      String?
  duplicateGroup      String?
  language            String    @default("en")
  sentimentModel      String?
  modelVersion        String?
  sentimentScore      Float?
  relevanceScore      Float?
  noveltyScore        Float?
  eventClassification String?
  confidence          Float?
  isScheduled         Boolean   @default(false)
  expiration          DateTime?
  licensingStatus     String    @default("VERIFIED_PUBLIC")
  evidenceStatus      String    @default("VERIFIED")

  @@index([publishedAt])
}

// -- Vibe-Trading Hash Audit Ledger --
model AuditLedger {
  id          String   @id @default(cuid())
  sequence    Int      @unique
  timestamp   DateTime @default(now())
  eventType   String
  data        Json
  dataHash    String
  prevHash    String
  chainHash   String   @unique

  @@index([eventType])
  @@index([sequence])
}

// Sentiment feed history (services/sentimentService.ts). One row per computed
// score; used for the mention-volume z-score and to evaluate whether sentiment
// actually improved decisions before giving it more weight.
model SentimentSnapshot {
  id           String    @id @default(cuid())
  asset        String
  market       String?
  score        Float
  confidence   Float
  mentionCount Int
  volumeZScore Float?
  sourceCounts Json
  newestItemAt DateTime?
  fearGreed    Int?
  scorer       String
  headlines    Json?
  createdAt    DateTime  @default(now())

  @@index([asset, createdAt])
}

// Every Polymarket edge-engine estimate (traded or skipped), scored against
// the real resolution for the scorecard (Brier, log loss, calibration).
model PolymarketPrediction {
  id                String    @id @default(cuid())
  venue             String
  marketSlug        String
  eventSlug         String?
  category          String?
  question          String
  endDate           DateTime?
  marketMid         Float
  bestBid           Float?
  bestAsk           Float?
  llmProb           Float?
  llmConfidence     Float?
  headlineCount     Int       @default(0)
  sentimentScore    Float?
  sentimentMentions Int       @default(0)
  momentum          Float?
  rawFair           Float
  fairProb          Float
  evidenceWeight    Float
  decision          String
  skipReason        String?
  side              String?
  netEdge           Float?
  execPrice         Float?
  feePerShare       Float?
  tradeId           String?
  outcome           Float?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  executions        PredictionExecution[]

  @@index([marketSlug, createdAt])
  @@index([resolvedAt])
  @@index([createdAt])
}

// Every directional forecast the stock/crypto system produces (Kronos model
// output and the council's own final call), persisted in scoreable form at
// production time so accuracy can be measured after the fact instead of
// asserted. A row is immutable evidence: scoring fills realizedPrice /
// realizedReturn / directionHit / brier / scoredAt once, after maturesAt.
// probabilityUp is the forecaster's stated P(price up over the horizon); for
// COUNCIL rows it is the council's stated confidence (NOT a calibrated
// probability -- the scorecard exists to measure exactly that gap). Kronos
// publishes no probability, so its rows carry probabilityUp = null and are
// scored on direction only. decisionId links a COUNCIL row to its
// AgentDecision so the forecast gate never treats a trade's own call as
// independent opposing evidence.
model ForecastRecord {
  id              String    @id @default(cuid())
  source          String    // 'KRONOS' | 'COUNCIL'
  asset           String
  market          String    // 'stocks' | 'crypto'
  direction       String    // 'UP' | 'DOWN' | 'FLAT'
  probabilityUp   Float?
  referencePrice  Float
  predictedPrice  Float?
  expectedReturn  Float?
  horizonBars     Int
  barDurationMs   Float
  maturesAt       DateTime
  decisionId      String?
  realizedPrice   Float?
  realizedReturn  Float?
  directionHit    Boolean?
  brier           Float?
  scoredAt        DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@index([asset, createdAt])
  @@index([source, createdAt])
  @@index([maturesAt, scoredAt])
}

// A real US submission owns a durable claim before transport. Never retry an
// ambiguous create: the exchange create contract has no client-order identifier.
model PredictionExecution {
  id                   String @id @default(cuid())
  claimKey             String @unique
  ownerId              String
  owner                User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  credentialScopeKey   String
  credentialIdentity   String
  predictionId         String
  prediction           PolymarketPrediction @relation(fields: [predictionId], references: [id], onDelete: Restrict)
  marketSlug           String
  side                 String
  quantity             Float
  sideLimitPrice       Float
  reservedUsd          Float
  authorityGeneration  Int
  planExpiresAt        DateTime
  riskPolicyHash       String
  qualificationId     String
  planNetEdge          Float
  status               String @default("PREPARING")
  brokerOrderId        String? @unique
  appliedQuantity      Float @default(0)
  appliedNotional      Float @default(0)
  appliedFees          Float @default(0)
  brokerState          Json?
  executionReferences  Json?
  activityEvidence     Json?
  cancelAttemptedAt    DateTime?
  holding              PredictionHolding?
  error                String?
  tradeId              String? @unique
  trade                Trade? @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([ownerId, credentialScopeKey, status])
  @@index([credentialScopeKey, marketSlug])
}

// A local mutation fence for the configured API grant. It is not a substitute
// for fresh broker account data or an exchange-wide account identifier.
model PredictionAccountAuthority {
  scopeKey   String @id
  generation Int @default(0)
  updatedAt  DateTime @updatedAt
}

// Opening evidence is frozen before the first reduction. The original Trade
// remains opening basis; this projection never overwrites it with sale fills.
model PredictionHolding {
  openingExecutionId String @id
  openingExecution PredictionExecution @relation(fields: [openingExecutionId], references: [id], onDelete: Restrict)
  ownerId String
  credentialScopeKey String
  marketSlug String
  side String
  openingQuantity Float
  openingNotional Float
  openingFees Float
  openingQualificationId String
  remainingQuantity Float
  remainingBasis Float
  realizedPnl Float?
  accountingStatus String @default("LINKED_ORDER_ONLY")
  reductions PredictionReduction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, credentialScopeKey])
}

model PredictionReduction {
  id String @id @default(cuid())
  claimKey String @unique
  openingExecutionId String
  holding PredictionHolding @relation(fields: [openingExecutionId], references: [openingExecutionId], onDelete: Restrict)
  ownerId String
  credentialScopeKey String
  credentialIdentity String
  marketSlug String
  side String
  quantity Float
  sideMinPrice Float
  authorityGeneration Int
  planExpiresAt DateTime
  policyEvidence Json?
  status String @default("PREPARING")
  brokerOrderId String? @unique
  appliedQuantity Float @default(0)
  appliedProceeds Float @default(0)
  appliedFees Float?
  terminalObserved Boolean @default(false)
  error String?
  observations PredictionReductionObservation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, credentialScopeKey, status])
}

model PredictionReductionObservation {
  id String @id
  reductionId String
  reduction PredictionReduction @relation(fields: [reductionId], references: [id], onDelete: Restrict)
  evidence Json
  observedAt DateTime @default(now())
  @@index([reductionId, observedAt])
}

// An immutable local owner-to-API-grant pin, NOT an exchange account identity.
// Rotation/ambiguous historical grants require review; never silently merge them.
model PredictionRecoveryState {
  ownerId                 String @id
  boundCredentialScopeKey String?
  cursorId                String?
  holdingCursorId         String?
  leaseId                 String?
  leaseUntil              DateTime?
  lastStartedAt           DateTime?
  lastFinishedAt          DateTime?
  lastOutcome             String?
  lastProcessed           Int @default(0)
  lastUnresolved          Int @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Simulated resting limit orders for Polymarket paper trading. They fill only
// if the market trades through the limit price, and expire after a TTL.
model PolymarketPaperOrder {
  id           String    @id @default(cuid())
  venue        String
  marketSlug   String
  eventSlug    String?
  category     String?
  question     String?
  side         String
  limitPrice   Float
  shares       Float
  status       String    @default("OPEN")
  predictionId String?
  fairAtOrder  Float?
  expiresAt    DateTime
  filledAt     DateTime?
  fillPrice    Float?
  tradeId      String?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([marketSlug])
}
