ALPACA_API_KEY=
ALPACA_BASE_URL=
ALPACA_SECRET_KEY=
ALPHA_VANTAGE_API_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_S3_BUCKET=
AWS_SECRET_ACCESS_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
CASH_RESERVE_PCT=
COINBASE_API_KEY=
COINBASE_SECRET_KEY=
DAILY_LOSS_LIMIT_PCT=
DATABASE_URL=
ENCRYPTION_KEY=
FINNHUB_API_KEY=
FRONTEND_URL=
GEMINI_API_KEY=
JWT_SECRET=
KRONOS_SERVICE_URL=
MAX_DRAWDOWN_ALL_TIME_PCT=
MAX_POSITION_SIZE_PCT=
MAX_RISK_PER_TRADE_PCT=
MAX_TRADES_PER_DAY=
MIN_AGENT_CONFIDENCE=
MIN_VOTES_TO_EXECUTE=
NEWSAPI_KEY=
OWNER_EMAIL=
OWNER_PHONE=
POLYGON_API_KEY=
PORT=3000
REDIS_URL=
SENTRY_DSN=
STOP_LOSS_CRYPTO_PCT=
STOP_LOSS_STOCKS_PCT=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_URL=
TAKE_PROFIT_PCT=
TRADING_MODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WEEKLY_DRAWDOWN_LIMIT_PCT=
# ── Added by 2026-09-28 audit ────────────────────────────────────────────────
NODE_ENV=production
# Required in production (>= 32 random chars). Generate: openssl rand -hex 32
# JWT_SECRET= / ENCRYPTION_KEY=  (see above)
OWNER_PASSWORD=
OWNER_SETUP_TOKEN=
STARTING_CAPITAL=100
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALLOW_SHORT_SELLING=false
PRE_DEBATE_GATE=on
LLM_DAILY_BUDGET_USD=1
# LLM routing: anthropic | ollama | nvidia | openai_compat
LLM_PROVIDER_FAST=ollama
LLM_MODEL_FAST=qwen2.5:14b-instruct
LLM_PROVIDER_SMART=anthropic
LLM_MODEL_SMART=
OLLAMA_BASE_URL=http://localhost:11434/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GEMINI_MODEL=
POLYMARKET_ALLOW_HEURISTIC_BETS=false
FRED_API_KEY=
# Postgres (Railway Postgres in production; docker-compose locally)
# DATABASE_URL=postgresql://user:pass@host:5432/db
# Live money needs all three: TRADING_MODE=live, ALPACA_LIVE_* keys, and:
#   LIVE_TRADING_CONFIRMED=I_ACCEPT_REAL_MONEY_RISK
# This ONE gate (backend/src/trading/liveGate.ts) covers every order path:
# stocks/crypto (Alpaca), the Polymarket scanner, Polymarket US and the Money
# Greed agent. Leave it empty to stay on paper.
LIVE_TRADING_CONFIRMED=
# true = never send broker orders; entries are simulated locally
DRY_RUN=false
# Polymarket US (api.polymarket.us, Ed25519-signed). Read-only by default.
# Live Polymarket orders need TRADING_MODE=live + LIVE_TRADING_CONFIRMED (above)
# AND POLYMARKET_US_LIVE=true. POLYMARKET_US_LIVE=true on its own does nothing.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
POLYMARKET_US_LIVE=false
# Max $ per Polymarket order. POLYMARKET_MAX_BET_USD is accepted as an alias
# (older name used by services/polymarket.ts); if both are set this one wins.
POLYMARKET_US_MAX_ORDER_USD=5
# SEC EDGAR requires a real contact in the User-Agent
SEC_USER_AGENT=

# ── AI brain (2026-09-29) ─────────────────────────────────────────────────────
# NVIDIA NIM (free developer tier) runs the agents; Claude is optional and used
# only as a fallback when ANTHROPIC_API_KEY has credit. Router fails over
# primary → NVIDIA fallback model → Anthropic automatically.
NVIDIA_API_KEY=
LLM_PROVIDER_FAST=nvidia
LLM_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
LLM_PROVIDER_SMART=nvidia
LLM_MODEL_SMART=nvidia/nemotron-3-ultra-550b-a55b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=60000
LLM_DAILY_BUDGET_USD=15
# LLM_AGENT_DELAY_MS=400

# ── Data ──────────────────────────────────────────────────────────────────────
FRED_API_KEY=
# FINNHUB_API_KEY / POLYGON_API_KEY / ALPHA_VANTAGE_API_KEY / NEWSAPI_KEY as before
# ALPACA_DATA_FEED=iex   # 'sip' with a paid Alpaca data plan

# ── Intraday fast lane ────────────────────────────────────────────────────────
INTRADAY_ENABLED=true
INTRADAY_MAX_TRADES_PER_DAY=150
INTRADAY_MAX_OPEN=15
INTRADAY_NOTIONAL_USD=250
INTRADAY_CANDIDATES_PER_SCAN=30
INTRADAY_ENTRIES_PER_SCAN=4
INTRADAY_MIN_SCORE=60
INTRADAY_MAX_HOLD_MIN=90
INTRADAY_SYMBOL_COOLDOWN_MIN=45
INTRADAY_MAX_DAILY_LOSS_USD=500
INTRADAY_USE_LLM=true
INTRADAY_REQUIRE_LLM=false

# ── Swing committee / Polymarket cadence ──────────────────────────────────────
SWING_DEBATES_PER_WINDOW=20
SWING_ENTRIES_PER_WINDOW=3
# Max concurrent open Polymarket bets (paper or live); one bet per market max.
POLYMARKET_MAX_OPEN=10
# Optional total $ cap on open Polymarket cost basis (0/empty = off)
POLYMARKET_MAX_TOTAL_EXPOSURE_USD=
POLYMARKET_SCAN_EVERY_MIN=15
# Markets analysed per scan (each = 1 LLM call + 1 headline lookup)
POLYMARKET_SCAN_MAX_MARKETS=200
API_RATE_LIMIT_PER_15MIN=6000

# ── Risk gate (read at call time by trading/riskManager.ts) ───────────────────
# DAILY_LOSS_LIMIT_PCT / WEEKLY_DRAWDOWN_LIMIT_PCT / MAX_DRAWDOWN_ALL_TIME_PCT /
# CASH_RESERVE_PCT / MAX_POSITION_SIZE_PCT / MAX_TRADES_PER_DAY above are now
# enforced. Defaults if unset: 3 / 6 / 10 / 20 / 15 / 50.
MAX_OPEN_POSITIONS=10
# MIN_AGENT_CONFIDENCE (0-100, default 50): signals below this are rejected.
# ALLOW_SHORT_SELLING=false → a SELL with no open position is skipped; a SELL on
# a held long closes it. Crypto is never shorted.

# ── Sentiment feed (X + news) — backend/src/services/sentimentService.ts ──────
# Filters and sizes technical trades; never opens a trade on its own.
# Unset = ON in paper mode, OFF in live mode (opt in explicitly for live).
SENTIMENT_ENABLED=
# Veto a BUY below -0.3 / a SELL above +0.3 when there are at least
# SENTIMENT_MIN_MENTIONS fresh items (newest <= SENTIMENT_MAX_AGE_MIN old).
SENTIMENT_VETO_THRESHOLD=0.3
SENTIMENT_MIN_MENTIONS=5
SENTIMENT_MAX_AGE_MIN=360
# News-volume z-score (vs. our own 7-day history) that nominates a symbol for
# a committee review in preDebateGate (still needs score >= +0.3 and an uptrend)
SENTIMENT_SPIKE_Z=2
SENTIMENT_LOOKBACK_HOURS=24
SENTIMENT_HALF_LIFE_HOURS=12
SENTIMENT_CACHE_TTL_SEC=900
SENTIMENT_HEADLINE_CACHE_TTL_SEC=1800
# GDELT asks for <= 1 request / 5 s
SENTIMENT_GDELT_MIN_INTERVAL_MS=5000
# Sources: Alpaca News uses the Alpaca keys above; Finnhub uses FINNHUB_API_KEY;
# alternative.me Fear & Greed and GDELT need no key.
# CryptoPanic (paid plans; free developer plan was discontinued):
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_API_PLAN=developer
# X API v2 recent search — only used when a bearer token is set. X bills per
# post read, so requests are capped per day and cached.
X_BEARER_TOKEN=
X_MAX_REQUESTS_PER_DAY=50
X_SEARCH_MAX_RESULTS=50
# Also search X for Polymarket question headlines (costs X reads)
SENTIMENT_X_FOR_POLYMARKET=false
# Scoring: FinBERT via kronos-service /api/sentiment when KRONOS_SERVICE_URL is
# set (see top of file); otherwise a built-in finance lexicon.
